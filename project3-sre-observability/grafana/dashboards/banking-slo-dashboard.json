{
  "title": "Banking SRE - SLO Overview",
  "uid": "banking-sre-slo",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Request Rate",
      "targets": [
        {
          "expr": "sum(rate(banking_http_requests_total[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "targets": [
        {
          "expr": "sum(rate(banking_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(banking_http_requests_total[5m])),0.001)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p99 Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.99,sum(rate(banking_http_request_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    }
  ]
}